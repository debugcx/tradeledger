# 复制为 .env 后修改；.env 已被 .gitignore 忽略，不要提交
# 访问密码：至少 16 位随机字符串
TRADELEDGER_PASSWORD=change-me-to-a-long-random-password

# 64 位十六进制主密钥。生成：openssl rand -hex 32
# 迁移已有数据库时必须沿用原 data/master.key 的内容，否则交易所 API 凭据无法解密
TRADELEDGER_MASTER_KEY=replace-with-64-hex-chars

# Caddy 使用的域名；本地测试可用 localhost
TRADELEDGER_DOMAIN=trade.example.com

TZ=Asia/Shanghai

# 0 = 首次启动不写入演示数据（生产推荐）
SEED_DEMO=0

# 如果服务器访问交易所需要代理（例如本机 Clash）：
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
