# 访问密码（必填；不设时开发回退 demo1234）
TRADELEDGER_PASSWORD=change-me

# 凭据加密主密钥（64 位十六进制）。不设时会在 data/master.key 生成。
# 已有的交易所 API 凭据依赖这个密钥；迁移时保持一致，否则需要重新填 Key。
# 生成：openssl rand -hex 32
# TRADELEDGER_MASTER_KEY=

# 主密钥文件位置（可选；默认与数据库同目录的 master.key）
# 独立部署建议放到数据目录之外，例如 /etc/tradeledger/master.key
# TRADELEDGER_MASTER_KEY_FILE=

# 首次启动是否写入演示数据（0 = 不写入，生产推荐）
SEED_DEMO=1

# 监听地址与端口
HOST=127.0.0.1
PORT=8790

# 数据库文件（可选，默认 data/tradeledger.db）
# DB_FILE=F:/data/tradeledger.db

# 统计时区（可选，默认跟随系统；例如 Asia/Shanghai）
# TRADELEDGER_TZ=Asia/Shanghai

# WebDAV 备份默认要求设置备份密码（未设置会阻止上传）。
# 仅在确认目标存储可信、且接受明文交易史时，才设为 1。
# TRADELEDGER_BACKUP_ALLOW_UNENCRYPTED=1

# 出站地址默认只允许 https（回环/私网可用 http）。
# 确需访问公网 http 服务时才设为 1，不推荐。
# TRADELEDGER_ALLOW_INSECURE_EGRESS=1

# 部署在可信反向代理（Caddy/Cloudflare Tunnel）后面时设为 1，
# 才会采信 X-Forwarded-For / CF-Connecting-IP（取最右值）。
# TRUST_PROXY=1

# 后台自动回溯历史：每多少秒推一批（0 = 关闭）
SYNC_WORKER_SECONDS=5

# 单批最多翻多少个 7 天窗口（防止多年历史一次发几百个请求）
SYNC_WINDOW_BUDGET=8

# 资金流水（充提/划转）刷新间隔，单位小时
TRANSFER_REFRESH_HOURS=6

# 现货成交刷新间隔，单位小时
SPOT_REFRESH_HOURS=1

# 实时持仓 / 余额 / 资金费率刷新间隔（0 = 关闭）
LIVE_REFRESH_SECONDS=60

# 未配置 HTTPS_PROXY 时，是否自动探测本机 7890/7897/10809/1080 代理（1 = 开启）
TRADELEDGER_AUTO_PROXY=1

# 资产总览：交易所账内资产（合约/现货/资金/理财/质押）刷新间隔，单位分钟
ASSET_REFRESH_MINUTES=10

# 资产总览：链上钱包索引服务刷新间隔，单位分钟；默认 4 小时，页面「资产总览 → 钱包」可改
WALLET_REFRESH_MINUTES=240
